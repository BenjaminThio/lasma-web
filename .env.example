# Copy to .env (local) or set these in your host's dashboard (production).
# Everything is read on the server only, except NEXT_PUBLIC_SITE_URL, which is baked in at build time.

# ─── Site (required in production) ─────────────────────────────────────────────
# The public origin, no trailing slash. Used for metadata, the sitemap, password reset links and
# Google sign-in. Reset links use this value, never the request's Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Data store (required in production) ───────────────────────────────────────
# "firestore" or "memory" (local development only; data resets on restart).
# When unset: Firestore if credentials are present, otherwise memory in development.
DATA_DRIVER=

# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; "\n" sequences are converted to real newlines at runtime.
FIREBASE_PRIVATE_KEY=

# Optional: use the local emulator instead (e.g. 127.0.0.1:8080).
FIRESTORE_EMULATOR_HOST=

# ─── Email (password resets) ───────────────────────────────────────────────────
# https://resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend.
# Without these, development logs reset links to the console; production cannot send them.
RESEND_API_KEY=
EMAIL_FROM="LASMA Studio <no-reply@example.com>"

# ─── Sign in with Google (optional) ────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Shared rate limits (recommended with more than one server instance) ───────
# https://upstash.com → Redis → REST API. Without these, each instance counts on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Multiple instances only ───────────────────────────────────────────────────
# Every instance must share this key, or Server Actions fail across instances.
# Generate one with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
